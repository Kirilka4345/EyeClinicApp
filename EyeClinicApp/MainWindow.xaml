<Window x:Class="EyeClinicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Глазная клиника «Зоркий глаз»" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        
        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Глазная клиника «Зоркий глаз»" 
                           FontSize="20" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtUserInfo" FontSize="13" Foreground="White" 
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Выйти" Style="{StaticResource DangerButton}" 
                            Padding="15,5" FontSize="12"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Навигация -->
        <Border Grid.Row="1" Background="White" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnPatients" Content="Пациенты" 
                        Style="{StaticResource PrimaryButton}" Margin="5" Padding="20,8"
                        Click="BtnPatients_Click"/>
                <Button x:Name="btnDoctors" Content="Врачи" 
                        Style="{StaticResource PrimaryButton}" Margin="5" Padding="20,8"
                        Click="BtnDoctors_Click" Background="{StaticResource AccentBrush}"/>
                <Button x:Name="btnDiagnoses" Content="Диагнозы" 
                        Style="{StaticResource PrimaryButton}" Margin="5" Padding="20,8"
                        Click="BtnDiagnoses_Click" Background="{StaticResource AccentBrush}"/>
                <Button x:Name="btnReports" Content="Отчёты" 
                        Style="{StaticResource PrimaryButton}" Margin="5" Padding="20,8"
                        Click="BtnReports_Click" Background="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Border>
        
        <!-- Основная таблица данных -->
        <Border Grid.Row="2" Margin="10" Background="White" CornerRadius="8">
            <DataGrid x:Name="dataGrid" AutoGenerateColumns="True" 
                      IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" 
                      HeadersVisibility="Column"
                      AlternatingRowBackground="#F5F8FC"
                      RowBackground="White"
                      BorderThickness="0"
                      FontSize="13"
                      SelectionMode="Single"
                      Margin="5">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
        
        <!-- Панель поиска и кнопок CRUD -->
        <Border Grid.Row="3" Background="White" Padding="10" Margin="10,0,10,5"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Поиск:" FontSize="14" FontWeight="Bold" 
                           VerticalAlignment="Center" Margin="5,0,10,0"/>
                <TextBox x:Name="txtSearch" Grid.Column="1" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,10,0"
                         TextChanged="TxtSearch_TextChanged"/>
                
                <ComboBox x:Name="cmbSearchField" Grid.Column="2" 
                          FontSize="13" Padding="8,6" Margin="0,0,10,0" Width="160"/>
                
                <Button Content="Добавить" Grid.Column="3" 
                        Style="{StaticResource SuccessButton}" 
                        Margin="5,0" Padding="15,8" FontSize="12"
                        Click="BtnAdd_Click" x:Name="btnAdd"/>
                <Button Content="Редактировать" Grid.Column="4" 
                        Style="{StaticResource WarningButton}" 
                        Margin="5,0" Padding="15,8" FontSize="12"
                        Click="BtnEdit_Click" x:Name="btnEdit"/>
                <Button Content="Удалить" Grid.Column="5" 
                        Style="{StaticResource DangerButton}" 
                        Margin="5,0" Padding="15,8" FontSize="12"
                        Click="BtnDelete_Click" x:Name="btnDelete"/>
                <Button Content="Обновить" Grid.Column="6" 
                        Style="{StaticResource PrimaryButton}" 
                        Margin="5,0" Padding="15,8" FontSize="12"
                        Click="BtnRefresh_Click"/>
            </Grid>
        </Border>
        
        <!-- Статусная строка -->
        <Border Grid.Row="4" Background="#E8E8E8">
            <TextBlock x:Name="txtStatus" FontSize="12" Foreground="#666" 
                       VerticalAlignment="Center" Margin="15,0"/>
        </Border>
    </Grid>
</Window>
