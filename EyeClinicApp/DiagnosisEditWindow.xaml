<Window x:Class="EyeClinicApp.DiagnosisEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диагноз" 
        Height="300" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid>
        <Border Background="White" CornerRadius="12" Margin="15">
            <StackPanel Margin="25">
                
                <TextBlock x:Name="txtTitle" Text="Добавление диагноза" 
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,20"/>
                
                <TextBlock Text="Наименование диагноза *" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>
                
                <TextBlock x:Name="txtError" Foreground="{StaticResource DangerBrush}" 
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Content="Сохранить" Grid.Column="0" 
                            Style="{StaticResource SuccessButton}" Click="BtnSave_Click"/>
                    <Button Content="Отмена" Grid.Column="2" 
                            Style="{StaticResource DangerButton}" Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
