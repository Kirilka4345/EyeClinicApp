<Window x:Class="EyeClinicApp.PatientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пациент" 
        Height="831" Width="506"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="0,0,0,15">
        <Border Background="White" CornerRadius="12" Margin="15,15,15,0">
            <StackPanel Margin="25">

                <TextBlock x:Name="txtTitle" Text="Добавление пациента" 
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,20"/>

                <!-- ФИО -->
                <TextBlock Text="ФИО пациента *" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFIO" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                <!-- Дата рождения -->
                <TextBlock Text="Дата рождения *" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <DatePicker x:Name="dpBirthDate" FontSize="14" Margin="0,0,0,10"/>

                <!-- Пол -->
                <TextBlock Text="Пол *" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbGender" FontSize="14" Padding="10,8" Margin="0,0,0,10">
                    <ComboBoxItem Content="Мужской"/>
                    <ComboBoxItem Content="Женский"/>
                </ComboBox>

                <!-- Адрес -->
                <TextBlock Text="Адрес *" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtAddress" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                <!-- Диагноз -->
                <TextBlock Text="Диагноз *" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbDiagnosis" FontSize="14" Padding="10,8" Margin="0,0,0,10"
                          DisplayMemberPath="НаименованиеДиагноза" SelectedValuePath="КодДиагноза"/>

                <!-- Лечащий врач -->
                <TextBlock Text="Лечащий врач *" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbDoctor" FontSize="14" Padding="10,8" Margin="0,0,0,10"
                          DisplayMemberPath="ФИОВрача" SelectedValuePath="КодВрача"/>

                <!-- Номер палаты -->
                <TextBlock Text="Номер палаты *" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtWard" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                <!-- Сообщение -->
                <TextBlock x:Name="txtError" Foreground="{StaticResource DangerBrush}" 
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>

                <!-- Кнопки -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Сохранить" Grid.Column="0" 
                            Style="{StaticResource SuccessButton}"
                            Click="BtnSave_Click"/>
                    <Button Content="Отмена" Grid.Column="2" 
                            Style="{StaticResource DangerButton}"
                            Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
