<Window x:Class="EyeClinicApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Глазная клиника «Зоркий глаз» — Авторизация" 
        Height="648" Width="513"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="-8,0,10,-34">
        <Grid.RowDefinitions>
            <RowDefinition Height="294*"/>
            <RowDefinition Height="367*"/>
        </Grid.RowDefinitions>
        <Border Background="White" CornerRadius="12" Margin="30,20,10,44" Grid.RowSpan="2">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Margin="30" VerticalAlignment="Center">

                <!-- Логотип / Заголовок -->
                <Ellipse Width="80" Height="80" Fill="{StaticResource PrimaryBrush}" 
                         HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="ЗГ" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" 
                           Margin="0,-60,0,25" Foreground="White"/>

                <TextBlock Text="Глазная клиника" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="«Зоркий глаз»" FontSize="16" 
                           HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,25"/>

                <!-- Логин -->
                <TextBlock Text="Логин" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLogin" Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,15"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль" FontSize="13" Foreground="#555" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}"
                             Margin="0,0,0,5"/>

                <!-- Показать пароль -->
                <Grid Margin="0,0,0,5">
                    <TextBox x:Name="txtPasswordVisible" Style="{StaticResource ModernTextBox}"
                             Visibility="Collapsed"/>
                </Grid>
                <CheckBox x:Name="chkShowPassword" Content="Показать пароль" 
                          FontSize="12" Foreground="#666" Margin="0,0,0,15"
                          Checked="ChkShowPassword_Changed" Unchecked="ChkShowPassword_Changed"/>

                <!-- Сообщение об ошибке -->
                <TextBlock x:Name="txtError" Foreground="{StaticResource DangerBrush}" 
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>

                <!-- Кнопки -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Войти" Grid.Column="0" 
                            Style="{StaticResource SuccessButton}"
                            Click="BtnLogin_Click"/>
                    <Button Content="Регистрация" Grid.Column="2" 
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnRegister_Click"/>
                    <Button Content="Выход" Grid.Column="4" 
                            Style="{StaticResource DangerButton}"
                            Click="BtnExit_Click"/>
                </Grid>

                <!-- Вход как гость -->
                <Button Content="Войти как гость" Margin="0,15,0,0"
                        Background="Transparent" Foreground="{StaticResource AccentBrush}"
                        BorderThickness="0" FontSize="13" Cursor="Hand"
                        Click="BtnGuest_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
