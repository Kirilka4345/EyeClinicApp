<Window x:Class="EyeClinicApp.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёты" 
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок и выбор отчёта -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="10,10,10,5" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Формирование отчётов" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Тип отчёта:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbReportType" Grid.Column="1" FontSize="14" Padding="10,8"
                              SelectionChanged="CmbReportType_Changed">
                        <ComboBoxItem Content="Список пациентов по диагнозам"/>
                        <ComboBoxItem Content="Статистика по врачам"/>
                        <ComboBoxItem Content="Пациенты по палатам"/>
                    </ComboBox>
                    <Button Content="Сформировать" Grid.Column="2" 
                            Style="{StaticResource PrimaryButton}" Padding="15,8"
                            Margin="10,0,0,0" Click="BtnGenerate_Click"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Таблица отчёта -->
        <Border Grid.Row="1" Margin="10,5" Background="White" CornerRadius="8">
            <DataGrid x:Name="reportGrid" AutoGenerateColumns="True" 
                      IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" 
                      AlternatingRowBackground="#F5F8FC"
                      BorderThickness="0" FontSize="13" Margin="5">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
        
        <!-- Кнопки экспорта -->
        <Border Grid.Row="2" Background="White" Padding="10" Margin="10,5,10,10" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Экспорт в Excel" Style="{StaticResource SuccessButton}" 
                        Padding="20,8" Margin="5" Click="BtnExportExcel_Click"/>
                <Button Content="Экспорт в PDF" Style="{StaticResource DangerButton}" 
                        Padding="20,8" Margin="5" Click="BtnExportPdf_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
